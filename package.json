{
  "name": "kikk-timetable",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "vp config",
    "snapshot": "node --env-file-if-exists=.env scripts/update-snapshot.ts",
    "og-image": "google-chrome --headless --hide-scrollbars --window-size=1200,630 --virtual-time-budget=5000 --screenshot=public/og-image.png http://localhost:3000/og-image",
    "server:deploy": "ssh kikk@bratwurst '~/KIKK-timetable/deploy/deploy.sh --force'",
    "server:backup": "mkdir -p backups && ssh kikk@bratwurst 'docker cp kikk-timetable:/app/.data - | gzip' > backups/kikk-data-$(date +%Y-%m-%d-%H%M).tar.gz"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@nuxt/icon": "^2.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "maplibre-gl": "^6.14.0",
    "nuxt": "^4.6.2",
    "posthog-js": "^1.438.12",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.95",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.30.2",
      "onFail": "download"
    }
  }
}
